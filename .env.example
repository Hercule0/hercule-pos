# Hercule License Server Environment Variables
APP_ENV=production

# Database (Azure App Service / secret store only)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Public service URL
HERCULE_PUBLIC_BASE_URL=https://pos-f7gxcvajd5gpf4dg.swedencentral-01.azurewebsites.net
HERCULE_API_CORS_ORIGINS=

# License response signing. Private key must never be committed.
LICENSE_PRIVATE_KEY=

# Desktop update signing. This must match the update public key embedded in
# Hercule POS. Use a different key from LICENSE_PRIVATE_KEY.
# Trust key: hercule-update-v2
# Public-key SHA-256: eaad6a494bbc7c6195556c01296451a5223e4081c40c964c3c3fc45ef50f9182
UPDATE_PRIVATE_KEY=

# Web Push. Rotate the historical VAPID pair before production deployment.
VAPID_SUBJECT=mailto:admin@herculepos.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# MFA encryption at rest
MFA_ENCRYPTION_KEY=

# Release storage
HERCULE_RELEASE_STORAGE_DIR=/home/data/hercule-pos/releases
HERCULE_RELEASE_MAX_UPLOAD_MB=512

# Hercule Cloud AI Router (set real secrets in Azure App Service only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
HERCULE_AI_PROVIDER_ORDER=gemini,groq,cloudflare
HERCULE_AI_PER_LICENSE_RPM=12
HERCULE_AI_GLOBAL_RPM=30
HERCULE_AI_IP_RPM=60
HERCULE_AI_429_COOLDOWN_SEC=45
HERCULE_AI_FAILURE_COOLDOWN_SEC=20
